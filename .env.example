# Ethereum JSON-RPC
# 실제 endpoint/API key는 .env에만 저장하고 Git에는 포함하지 않는다.
# 실제 DAG 실행 전 QuickNode, Alchemy, Infura 등 provider URL로 채운다.
# 현 사전 과제에서는 Alchemy을 사용하였습니다.
# 비워 둔 상태에서는 fixture/dbt 검증만 가능하며, 실제 DAG 수집은 설정 오류로 실패한다.
ETH_RPC_URL=
ETH_RPC_AUTH_MODE=none
ETH_RPC_USERNAME=
ETH_RPC_PASSWORD=
ETH_RPC_BEARER_TOKEN=

ETH_CHAIN_ID=1
ETH_LOG_MAX_BLOCK_RANGE=10
ETH_RPC_TIMEOUT_SECONDS=20
ETH_RPC_MAX_RETRIES=3
ETH_RPC_REQUESTS_PER_SECOND=4
ETH_RPC_CONCURRENCY=1
ETH_COLLECTION_SCOPE_MODE=transfer_topic_all_addresses
ETH_LOG_ADDRESS_FILTER=
ETH_LOG_TOPIC0=0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef

# Airflow local/container settings
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=airflow

AIRFLOW__WEBSERVER__SECRET_KEY=<CHANGE_ME_FOR_LOCAL_AIRFLOW>

# Local container storage
DELTA_LOGS_PATH=/opt/airflow/data/delta/ethereum_logs
DUCKDB_PATH=/opt/airflow/data/analytics/ethereum_analytics.duckdb
DUCKDB_EXTENSION_DIR=/opt/airflow/data/duckdb_extensions

# dbt
DBT_PROJECT_DIR=/opt/airflow/dbt
DBT_PROFILES_DIR=/opt/airflow/dbt
DBT_USDT_CONTRACT_ADDRESS=0xdac17f958d2ee523a2206206994597c13d831ec7
DBT_TETHER_TREASURY_ADDRESS=0x5754284f345afc66a98fbb0a0afe71e0f007b949
DBT_USDT_DECIMALS=6

ETH_AIRFLOW_MANUAL_RUN_MODE=data_interval
ETH_AIRFLOW_RECENT_WINDOW_SECONDS=120
ETH_AIRFLOW_RECENT_FINALIZED_LAG_SECONDS=0

# Logging
LOG_LEVEL=INFO
